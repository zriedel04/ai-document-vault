  "info": {
    "title": "AI Document Vault",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/documents": {
      "get": {
        "description": "One page of documents in use (or, with ``trash``, of the trash), sorted by when they were\nadded, their name or their size, newest first unless ``order`` says otherwise. ``total``\ncounts every document the list holds, so the page can show how many pages there are.",
        "operationId": "read_documents_api_documents_get",
        "parameters": [
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortKey",
              "default": "added"
            }
          },
          {
            "in": "query",
            "name": "order",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/Order",
              "default": "desc"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 1000000000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "trash",
            "required": false,
            "schema": {
              "default": false,
              "title": "Trash",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Documents",
        "tags": [
          "documents"
        ]
      }
    },
    "/api/documents/{document_id}": {
      "delete": {
        "description": "Delete a document in the trash for good: its versions, imports, pages and jobs, and each\nstored file that no other document uses. It cannot be undone. A document in use is refused\n(409) and left as it is; it must be moved to the trash first. An unknown id is a 404, also when\nthe document was deleted by an earlier request.\n\nThe answer is 204 once the rows are gone, even if a file could not be removed now: the start-up\nsweep moves such a file to ``blobs/orphans/`` (``vault.storage.purge``).",
        "operationId": "delete_document_api_documents__document_id__delete",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No such document"
          },
          "409": {
            "description": "The document is not in the trash"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Document",
        "tags": [
          "documents"
        ]
      },
      "get": {
        "description": "One document, in use or in the trash: what the list shows, plus its hash, current version,\nevery import (oldest first; the first names the document) and its processing jobs (in the\norder of the pipeline). An unknown id, or one that is not an id at all, is a 404 whose message\ndoes not repeat it.",
        "operationId": "read_document_api_documents__document_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such document"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Document",
        "tags": [
          "documents"
        ]
      }
    },
    "/api/documents/{document_id}/file": {
      "get": {
        "description": "The document's current bytes, exactly as imported, saved under the name of its first import.\nAlways an attachment, so the browser saves it and never shows it as a page of this origin.",
        "operationId": "download_document_api_documents__document_id__file_get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/octet-stream": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "The original file, as an attachment, with its own media type"
          },
          "404": {
            "description": "No such document"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "description": "The stored copy is missing, or two files claim its hash"
          }
        },
        "summary": "Download Document",
        "tags": [
          "documents"
        ]
      }
    },
    "/api/documents/{document_id}/pages": {
      "get": {
        "description": "The extracted text of the document's current version (in use or in the trash, like the\ndetails), as plain text by page, with each page's headings. A window starts after ``offset``\npages and holds at most ``limit`` pages and about a million characters: a page that would pass\nthat is left for the next window, but the first page of a window is always sent whole.\n``next_offset`` says where the next window starts. A document whose text has not been\nextracted yet answers with ``extracted`` false and no pages, not a 404.",
        "operationId": "read_document_pages_api_documents__document_id__pages_get",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "offset",
            "required": false,
            "schema": {
              "default": 0,
              "maximum": 1000000000,
              "minimum": 0,
              "title": "Offset",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentPages"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such document"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "description": "The stored text of this document breaks the page rules"
          }
        },
        "summary": "Read Document Pages",
        "tags": [
          "documents"
        ]
      }
    },
    "/api/documents/{document_id}/restore": {
      "post": {
        "description": "Bring a document out of the trash, in the state it had, and return it as it now is. A\ndocument that is not in the trash is returned unchanged.",
        "operationId": "restore_document_api_documents__document_id__restore_post",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such document"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Restore Document",
        "tags": [
          "documents"
        ]
      }
    },
    "/api/documents/{document_id}/trash": {
      "post": {
        "description": "Move a document to the trash and return it as it now is. Nothing is deleted: its file,\nversions, imports and jobs stay, and a restore brings it back in the state it had. A document\nalready in the trash stays there with the time it first went there.",
        "operationId": "trash_document_api_documents__document_id__trash_post",
        "parameters": [
          {
            "in": "path",
            "name": "document_id",
            "required": true,
            "schema": {
              "title": "Document Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DocumentDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such document"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Trash Document",
        "tags": [
          "documents"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Report that the server is up. Reads nothing from the vault or the database.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/imports/upload": {
      "post": {
        "description": "Import one file sent as the request body. The answer says whether it became a new\ndocument, was already in the vault (a new source for that document), or was refused.",
        "operationId": "upload_api_imports_upload_post",
        "parameters": [
          {
            "in": "header",
            "name": "x-vault-filename",
            "required": true,
            "schema": {
              "title": "X-Vault-Filename",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "x-vault-batch",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Vault-Batch"
            }
          },
          {
            "in": "header",
            "name": "x-vault-last-modified",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "X-Vault-Last-Modified"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/octet-stream": {
              "schema": {
                "format": "binary",
                "type": "string"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UploadResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "A malformed request"
          },
          "413": {
            "description": "Too large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Upload",
        "tags": [
          "imports"
        ]
      }
    },
    "/api/session": {
      "get": {
        "description": "Who is making this request. Needs the token, so it also tells the app whether it has one.",
        "operationId": "read_session_api_session_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Session",
        "tags": [
          "session"
        ]
      }
    }
  }
}
